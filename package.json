{
  "name": "codetype-race",
  "private": true,
  "workspaces": ["shared", "lambdas", "web", "infra"],
  "scripts": {
    "dev": "bun --filter @codetype/web dev",
    "build": "bun --filter @codetype/web build",
    "start": "bun --filter @codetype/web start",
    "lint": "bun --filter @codetype/web lint",
    "test": "bun --filter '*' test",
    "cdk": "bun --filter @codetype/infra exec cdk",
    "seed": "bun scripts/seed-snippets.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0"
  },
  "devDependencies": {
    "aws-cdk": "^2.158.0",
    "tsx": "^4.19.0"
  }
}
