{
  "name": "codetype-race",
  "private": true,
  "workspaces": ["shared", "domain", "app", "web"],
  "scripts": {
    "dev": "bun --filter @codetype/web dev",
    "build": "bun --filter @codetype/web build",
    "start": "bun --filter @codetype/web start",
    "lint": "bun --filter @codetype/web lint",
    "test": "bun --filter '*' test",
    "check:deps": "bun scripts/check-deps.ts",
    "check:fonts": "bun --filter @codetype/web check:fonts",
    "check": "bun run check:deps && bun run check:fonts"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
